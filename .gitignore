# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/bin/
/.gradle/
/build/
/dependences/
/lib/
*.properties
# The gradle wrapper, against the two rules above. It is not build output and not
# configuration: it is how this repository states which Gradle builds it, and a
# checkout without it cannot build at all. `*.jar` and `*.properties` are right for
# everything else here, including gradle.properties, which has held credentials.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
